APP_NAME=Laravel
APP_SERVICE=sorteandoaqui
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker (compose.yaml) — ports exposed on the host
# 80 is already taken on this machine by another project's container
APP_PORT=8000
APP_TZ=America/Recife
VITE_PORT=5173
XDEBUG_PORT=9003

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sorteandoaqui_db
DB_USERNAME=sorteandoaqui
DB_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (S3-compatible) — ver docker/develop/README.md
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=8900
AWS_ACCESS_KEY_ID=sorteandoaqui
AWS_SECRET_ACCESS_KEY=sorteandoaqui
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET="${APP_SERVICE}-${APP_ENV}"
AWS_ENDPOINT="http://minio:${FORWARD_MINIO_PORT}"
AWS_URL="http://localhost:${FORWARD_MINIO_PORT}/${AWS_BUCKET}"
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
